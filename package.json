{
  "name": "lume-engine-workspace",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build && pnpm build:wasm && pnpm -r --filter './examples/**' build && pnpm -r --filter './benchmarks/**' build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "prepare:examples": "pnpm -r --filter './packages/**' build && pnpm build:wasm",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev": "pnpm --filter @lume/example-cube dev",
    "preview": "pnpm --filter @lume/example-cube preview",
    "benchmark": "cargo run --release -p lume-benchmarks -- --output benchmarks/results/internal-latest.json",
    "benchmark:transport": "pnpm --filter @lume/runtime build && node --expose-gc benchmarks/transport/run.mjs",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "lint": "eslint . && cargo clippy --workspace --all-targets -- -D warnings",
    "typecheck": "pnpm -r --filter './packages/**' build && pnpm -r typecheck",
    "test": "pnpm test:rust && pnpm test:ts",
    "test:packaging": "node scripts/test-packaged-consumer.mjs",
    "test:rust": "cargo test --workspace",
    "test:ts": "pnpm -r --filter './packages/**' test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@webgpu/types": "catalog:",
    "eslint": "^10.8.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "typescript-eslint": "^8.65.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
